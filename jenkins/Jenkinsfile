pipeline {
    agent any

    stages {
        stage('Unit Tests - Backend') {
            agent {
                docker {
                    image 'thamibones/spa-booking:tests'
                    reuseNode true
                }
            }
            environment {
                HOME = '/tmp'
            }
            steps {
                dir("backend/tests"){
                   sh 'uv run pytest -vv'
                }
            }
        }
    }
}
