pipeline {
    agent any

    stages {
        stage('Unit Tests - Backend') {
            agent {
                docker {
                    image 'thamibones/spa-booking:tests'
                    reuseNode true
                }
            }
            environment {
                HOME = '/tmp'
            }
            steps {
                dir("backend/tests"){
                   sh 'uv run pytest -vv'
                }
            }
        }

        stage("Launch Application") {
            agent {
                docker {
                    image 'docker:27.5.1'
                    reuseNode true
                    args '-v /var/run/docker.sock:/var/run/docker.sock -u 0'
                }
            }
            steps {
                dir("backend") {
                    sh 'docker compose up --build --wait'
                }    
            }
        }

        stage("API Tests") {
            agent {
                docker {
                    image 'thamibones/spa-booking:tests'
                    reuseNode true
                    args '-u 0 --network=host'
                }
            }
            environment {
                HOME = '/tmp'
                DB_URL = credentials('DB_URL')
                DB_NAME = credentials('DB_NAME')
            }          
            steps {
                dir("backend/tests_api") {
                    sh 'uv run pytest -vv'
                }
            }
        }

        stage('Deploy') {
            when {
                branch 'main'
            }
            agent {
                docker {
                    image 'ghcr.io/astral-sh/uv:python3.12-bookworm-slim'
                    reuseNode true
                }
            }
            environment {
                FASTAPI_CLOUD_TOKEN = credentials('fastapi-cloud-token')
                FASTAPI_CLOUD_APP_ID = credentials('fastapi-cloud-app-id')
                HOME = '/tmp'
            }
            steps {
                checkout scm
                sh 'uv run fastapi deploy'
            }
        }
    }
}
